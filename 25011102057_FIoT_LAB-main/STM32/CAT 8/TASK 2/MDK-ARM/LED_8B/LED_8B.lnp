--cpu Cortex-M3
"led_8b\startup_stm32f103xb.o"
"led_8b\main.o"
"led_8b\stm32f1xx_it.o"
"led_8b\stm32f1xx_hal_msp.o"
"led_8b\stm32f1xx_hal_gpio_ex.o"
"led_8b\stm32f1xx_hal.o"
"led_8b\stm32f1xx_hal_rcc.o"
"led_8b\stm32f1xx_hal_rcc_ex.o"
"led_8b\stm32f1xx_hal_gpio.o"
"led_8b\stm32f1xx_hal_dma.o"
"led_8b\stm32f1xx_hal_cortex.o"
"led_8b\stm32f1xx_hal_pwr.o"
"led_8b\stm32f1xx_hal_flash.o"
"led_8b\stm32f1xx_hal_flash_ex.o"
"led_8b\stm32f1xx_hal_exti.o"
"led_8b\system_stm32f1xx.o"
--strict --scatter "LED_8B\LED_8B.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "LED_8B.map" -o LED_8B\LED_8B.axf