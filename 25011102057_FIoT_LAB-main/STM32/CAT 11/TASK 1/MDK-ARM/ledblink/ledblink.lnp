--cpu=Cortex-M4.fp.sp
"ledblink\startup_stm32f410rx.o"
"ledblink\main.o"
"ledblink\stm32f4xx_it.o"
"ledblink\stm32f4xx_hal_msp.o"
"ledblink\stm32f4xx_hal_rcc.o"
"ledblink\stm32f4xx_hal_rcc_ex.o"
"ledblink\stm32f4xx_hal_flash.o"
"ledblink\stm32f4xx_hal_flash_ex.o"
"ledblink\stm32f4xx_hal_flash_ramfunc.o"
"ledblink\stm32f4xx_hal_gpio.o"
"ledblink\stm32f4xx_hal_dma_ex.o"
"ledblink\stm32f4xx_hal_dma.o"
"ledblink\stm32f4xx_hal_pwr.o"
"ledblink\stm32f4xx_hal_pwr_ex.o"
"ledblink\stm32f4xx_hal_cortex.o"
"ledblink\stm32f4xx_hal.o"
"ledblink\stm32f4xx_hal_exti.o"
